{
  "name": "buildbridge",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "demo": "node --env-file=.env src/cli.js demo",
    "quote": "node --env-file=.env src/cli.js quote",
    "research": "node --env-file=.env src/cli.js research",
    "parse": "node src/parse-cli.js",
    "test": "node --test test/*.test.js",
    "example:supplier": "node --env-file=.env examples/run-supplier-task.js",
    "example:research": "node --env-file=.env examples/run-research-task.js",
    "example:parser": "node examples/run-parser-task.js",
    "example:draft": "node examples/run-draft-example.js",
    "draft": "node src/draft-cli.js",
    "start": "node src/pilot/start.js",
    "db:migrate": "node src/pilot/admin-cli.js migrate",
    "pilot:seed": "node src/pilot/admin-cli.js seed-demo",
    "admin:bootstrap": "node src/pilot/admin-cli.js bootstrap",
    "admin:reset-password": "node src/pilot/admin-cli.js reset-password",
    "evaluate": "node src/evaluate-cli.js",
    "check": "node ops/check.js",
    "backup": "node ops/backup.js",
    "restore": "node ops/restore.js"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.5",
    "@fastify/helmet": "^13.2.0",
    "@napi-rs/canvas": "^1.1.0",
    "fastify": "^5.12.7",
    "pdfjs-dist": "^6.4.299",
    "pg": "^8.23.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.3.16"
  }
}
