ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
ANTHROPIC_EFFORT=low
# Local pilot uses an embedded database when DATABASE_URL is empty.
# Production requires PostgreSQL, HTTPS, a restricted runtime login, and real supplier data.
DATABASE_URL=
APP_ORIGIN=http://localhost:3000
PORT=3000
SERVER_HOST=127.0.0.1
METRICS_TOKEN=
SUPPLIER_DATA_FILE=
ALLOW_SAMPLE_DATA=false
DAILY_MODEL_CALLS=200
DAILY_TOKEN_BUDGET=500000
ALERT_WEBHOOK_URL=
# Keep these in a production secret manager; never commit populated values.
BACKUP_KEY=
BACKUP_DIRECTORY=output/backups
RESTORE_DATABASE_URL=
RESTORE_CONFIRM_EMPTY=false
BOOTSTRAP_EMAIL=
BOOTSTRAP_PASSWORD=
# Python website (uses the same ANTHROPIC_API_KEY and ANTHROPIC_MODEL above).
QBC_SECRET_KEY=
QBC_DB_PATH=output/quote-builder.db
QBC_SUPPLIER_BINDINGS_FILE=
# Local synthetic supplier demo only; forbidden in production.
QBC_ALLOW_SAMPLE_SUPPLIER=false
